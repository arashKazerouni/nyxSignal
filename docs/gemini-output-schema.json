{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NyxSignal Gemini Market Analysis",
  "type": "object",
  "required": [
    "analysis_timestamp",
    "market_regime",
    "market_summary",
    "strategies",
    "opportunities",
    "top_opportunities",
    "no_trade_conditions"
  ],
  "properties": {
    "analysis_timestamp": { "type": "string", "format": "date-time" },
    "market_regime": {
      "type": "object",
      "required": ["primary", "secondary", "explanation"],
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "string" },
        "explanation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "market_summary": {
      "type": "object",
      "required": ["btc_condition", "eth_condition", "market_sentiment", "volatility", "major_catalysts", "major_risks"],
      "properties": {
        "btc_condition": { "type": "string" },
        "eth_condition": { "type": "string" },
        "market_sentiment": { "type": "string" },
        "volatility": { "type": "string" },
        "major_catalysts": { "type": "array", "items": { "type": "string" } },
        "major_risks": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["strategy", "suitable_horizons", "reason", "failure_conditions"],
        "properties": {
          "strategy": { "type": "string" },
          "suitable_horizons": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" },
          "failure_conditions": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "prediction_id", "asset", "symbol", "trading_pair", "timeframe", "current_price",
          "setup", "strategy", "entry_zone", "target_1", "target_2", "invalidation_price",
          "expected_upside_percent", "expected_downside_percent", "risk_reward_ratio", "probabilities",
          "confidence", "risk", "allocation", "evidence", "catalysts", "invalidation_reasons"
        ],
        "properties": {
          "prediction_id": { "type": "string", "minLength": 1 },
          "asset": { "type": "string" },
          "symbol": { "type": "string" },
          "trading_pair": { "type": "string" },
          "timeframe": { "type": "string" },
          "current_price": { "type": ["number", "null"] },
          "setup": { "type": "string" },
          "strategy": { "type": "string" },
          "entry_zone": {
            "type": "object",
            "required": ["low", "high"],
            "properties": {
              "low": { "type": ["number", "null"] },
              "high": { "type": ["number", "null"] }
            },
            "additionalProperties": false
          },
          "target_1": { "type": ["number", "null"] },
          "target_2": { "type": ["number", "null"] },
          "invalidation_price": { "type": ["number", "null"] },
          "expected_upside_percent": { "type": ["number", "null"] },
          "expected_downside_percent": { "type": ["number", "null"] },
          "risk_reward_ratio": { "type": ["number", "null"] },
          "probabilities": {
            "type": "object",
            "required": ["profit", "flat", "loss"],
            "properties": {
              "profit": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "flat": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "loss": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "risk": {
            "type": "object",
            "required": ["score", "level", "main_risks"],
            "properties": {
              "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
              "level": { "type": "string" },
              "main_risks": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          },
          "allocation": {
            "type": "object",
            "required": ["recommended_percent", "recommended_amount", "maximum_exposure_percent"],
            "properties": {
              "recommended_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
              "recommended_amount": { "type": ["number", "null"], "minimum": 0 },
              "maximum_exposure_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
            },
            "additionalProperties": false
          },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "catalysts": { "type": "array", "items": { "type": "string" } },
          "invalidation_reasons": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "top_opportunities": {
      "type": "object",
      "required": ["scalping", "short_term", "swing", "medium_term", "long_term"],
      "properties": {
        "scalping": { "type": "array", "items": { "type": "string" } },
        "short_term": { "type": "array", "items": { "type": "string" } },
        "swing": { "type": "array", "items": { "type": "string" } },
        "medium_term": { "type": "array", "items": { "type": "string" } },
        "long_term": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "no_trade_conditions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
